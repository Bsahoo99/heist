      "title": "Findings",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/SceneMeta"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/SceneZone"
      },
      "title": "Zones",
      "type": "array"
    }
