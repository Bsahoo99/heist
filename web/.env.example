# Where the browser reaches the engine. A URL, not a secret: on Vercel, the Modal endpoint
# (https://<workspace>--heist-engine-web.modal.run). Empty means the local engine on port 8000.
NEXT_PUBLIC_ENGINE_URL=
# Optional, server only: where the badge route reaches the engine. Defaults to NEXT_PUBLIC_ENGINE_URL.
HEIST_ENGINE_URL=
# Optional: the site's public origin (for example https://heist.example), so share cards
# (og:image) use it. Empty keeps Next's default, the Vercel production domain.
NEXT_PUBLIC_SITE_URL=
